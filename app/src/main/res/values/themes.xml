<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Likkho" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/likkho_splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Likkho.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/likkho_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_open_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/likkho_splash_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Likkho</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.RamLal" parent="Theme.Likkho" />
</resources>
